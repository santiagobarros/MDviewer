<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Read-only access inside the user's home: lets previews load images the
         markdown references and the shared Mermaid SVG cache. Quick Look itself
         grants access to the previewed file; nothing outside home is reachable
         and nothing is writable. -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
    <array>
        <string>/</string>
    </array>
    <!-- Lets the extension reach the (optional) on-demand mermaid render helper. -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>com.local.markdown-viewer.render-helper</string>
    </array>
</dict>
</plist>
